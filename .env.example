# Mailchimp for the waitlist form (app/api/waitlist/route.ts).
# Copy to .env.local and fill in. Until these are set, signups are only logged on the server.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Merge tags of the audience fields for the two optional questions
MAILCHIMP_SOURCE_FIELD=SOURCE
MAILCHIMP_MOTIVE_FIELD=MOTIVE
